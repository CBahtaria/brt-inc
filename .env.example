# BRT Inc. environment variables
# Copy to .env and fill in values — never commit .env

# Stripe payment links (set via stripe-update.sh after Stripe account creation)
STRIPE_STARTER_URL=https://buy.stripe.com/PLACEHOLDER
STRIPE_PROFESSIONAL_URL=https://buy.stripe.com/PLACEHOLDER
STRIPE_CUSTOM_URL=https://buy.stripe.com/PLACEHOLDER

# Supabase — all three values required
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to put in browser source (src/js/supabase-client.js)
# SUPABASE_SERVICE_ROLE_KEY must NEVER be in browser source — server-side only (api/ functions)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend email API (server-side only)
RESEND_API_KEY=

# Stripe server-side keys (never expose to client)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AUDIT_LITE=price_...
STRIPE_PRICE_AUDIT_STANDARD=price_...
STRIPE_PRICE_AUDIT_PREMIUM=price_...
STRIPE_PRICE_RETAINER_ESSENTIAL=price_...
STRIPE_PRICE_RETAINER_PROFESSIONAL=price_...
STRIPE_PRICE_CONSULTATION=price_...
NEXT_PUBLIC_BASE_URL=https://brt-inc.vercel.app

# Next.js public Supabase vars (exposed to browser — anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Higgsfield AI — server-side only, never expose to client
HIGGSFIELD_API_KEY=
# Override if the base URL changes (default: https://api.higgsfield.ai)
# HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai
